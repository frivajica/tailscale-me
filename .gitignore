# Build artifacts — the exe embeds the auth key, never commit it
/dist/
/TailscaleMe.exe
/tailscale-me
*.exe
*.syso
/tmp/
/aclcheck
/pack

# Secrets — never commit a live auth key or SSH private key
.authkey
.sshkey
.allow-cidr
.sshpassword
.sshpassauth

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db
Desktop.ini